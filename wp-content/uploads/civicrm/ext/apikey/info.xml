<?xml version="1.0"?>
<extension key="com.cividesk.apikey" type="module">
  <file>apikey</file>
  <name>API Key Management</name>
  <description>Provides an interface for managing CiviCRM API user keys.</description>
  <urls>
    <url desc="Licensing">http://civicrm.org/licensing</url>
    <url desc="Main Extension Page">https://civicrm.org/extensions/api-key</url>
    <url desc="Support">https://lab.civicrm.org/extensions/apikey/-/work_items</url>
    <url desc="Documentation">https://docs.civicrm.org/sysadmin/en/latest/setup/api-keys/</url>
  </urls>
  <license>AGPL v3</license>
  <maintainer>
    <author>Mathieu Lu</author>
    <email>mathieu@civicrm.org</email>
  </maintainer>
  <authors>
    <author>
      <name>Nicolas Ganivet</name>
      <email>nicolas@cividesk.com</email>
      <homepage>https://cividesk.com</homepage>
      <role>Maintainer</role>
    </author>
    <author>
      <name>Mikey O'Toole</name>
      <email>mikey@mjco.uk</email>
      <homepage>https://mjco.uk</homepage>
      <role>Maintainer</role>
    </author>
  </authors>
  <releaseDate>2026-07-18</releaseDate>
  <version>1.5.1</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.10</ver>
  </compatibility>
  <comments>Once installed, an 'API Key' tab will be available on contact screens for which you are authorized to manage the key. You are authorized either if the contact if yourself, or if you are an administrator with the 'edit all contacts' permission.</comments>
  <civix>
    <namespace>CRM/Apikey</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
